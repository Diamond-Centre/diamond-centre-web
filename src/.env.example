# Mode local sans base de données ni JWT
# Pour activer PostgreSQL + JWT : décommenter DATABASE_URL et JWT_SECRET,
# puis réactiver le code prisma dans lib/db.js et les routes API.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diamond_centre"
JWT_SECRET="change_me"

NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=Diamond Centre
