# Browser calls same-origin /api (NO CORS in the browser).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=Diamond Centre

# Where Next.js proxies /api → DICE backend (server-side only).
# This machine runs the backend — use loopback (most reliable).
BACKEND_URL=http://127.0.0.1:3001

# Colleagues on the LAN should use your current IP instead:
# BACKEND_URL=http://192.168.1.112:3001
