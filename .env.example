# Browser uses same-origin /api — Next.js proxies to the real backend.
# This avoids CORS errors in the browser.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=Diamond Centre

# Server-side only: DICE backend base URL (no /api suffix).
# Local (you run backend on same PC):
BACKEND_URL=http://127.0.0.1:3001

# Colleague connecting to the shared host backend (change IP if needed):
# BACKEND_URL=http://192.168.1.113:3001
