# =============================================================================
# Diamond Centre Web — environment template
# =============================================================================
# Copy to .env for local work, or import into Vercel (Import .env).
# Only uncommented KEY=value lines are used / imported.
#
# Production values are ACTIVE.
# Local values are commented.
# =============================================================================

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=Diamond Centre

# --- Production (active — Vercel web → Vercel API) ---
# No trailing slash, no /api suffix
BACKEND_URL=https://diamond-centre-api.vercel.app

# --- Local development (commented) ---
# BACKEND_URL=http://127.0.0.1:3001
