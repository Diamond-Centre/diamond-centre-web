# Browser calls same-origin /api (NO CORS in the browser).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_NAME=Diamond Centre

# Where Next.js proxies /api → DICE backend (server-side only).
# Shared backend host on the LAN (works for the whole team on the same network).
BACKEND_URL=http://192.168.1.113:3001

# If you run the backend on YOUR OWN machine instead, use:
# BACKEND_URL=http://127.0.0.1:3001
